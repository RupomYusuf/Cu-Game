/* ============ Pack Games: Flag, Yes/No, T/F, Rapid Fire, Mad Libs, KMK ============ */
/* All follow the secret-pick reveal pattern — both answer independently, reveal together. */

/* shared helpers for pack games */
function packTwoChoice(title, icon, desc, opts, cards, kind, extraRender, scoreLabel) {
  return {
    name: title, icon, desc,
    init(root, api) {
      const S = { q: 0, mine: null, theirs: null, synced: 0, rounds: 0 };
      root.innerHTML = `<div class="game-panel">
        <div class="game-prompt">${desc}</div>
        <div class="big-card-question" id="pc-q" style="min-height:80px"></div>
        <div class="likely-buttons" id="pc-buttons"></div>
        <div id="pc-result"></div>
        <div style="margin-top:12px"><button class="btn btn-primary" id="pc-next" style="display:none">Next →</button></div>
      </div>`;
      const qEl = root.querySelector('#pc-q');
      const btnsEl = root.querySelector('#pc-buttons');
      const resultEl = root.querySelector('#pc-result');
      const nextBtn = root.querySelector('#pc-next');

      function render() {
        const card = cards[S.q % cards.length];
        const isObj = typeof card === 'object';
        const text = isObj ? card.s : card;
        qEl.textContent = text;
        btnsEl.innerHTML = '';
        const revealed = S.mine !== null && S.theirs !== null;
        opts.forEach(([label, val, cls]) => {
          const b = document.createElement('button');
          b.className = 'likely-btn ' + (cls || '');
          b.textContent = label;
          if (revealed) {
            b.disabled = true;
            if (S.mine === val && S.theirs === val) { b.classList.add('match'); b.textContent += ' ⭐'; }
            else if (S.mine === val) { b.classList.add('selected'); b.textContent += ' (you)'; }
            else if (S.theirs === val) { b.classList.add('selected'); b.textContent += ` (${api.partnerName})`; }
          } else {
            if (S.mine === val) b.classList.add('selected');
            b.onclick = () => {
              S.mine = val;
              render();
              api.send({ kind: 'pick', pick: val });
              if (extraRender) extraRender(S, root);
            };
          }
          btnsEl.appendChild(b);
        });
        if (revealed) {
          const match = S.mine === S.theirs;
          let html = '';
          if (kind === 'flag') {
            html = match ? `<div class="result-banner ${S.mine === 'green' ? 'win' : 'lose'}">Both see it the same way! ${S.mine === 'green' ? '🟢 Green flag!' : '🚩 Red flag!'}</div>`
                        : `<div class="result-banner draw">You disagree! Time to discuss 😄</div>`;
          } else if (kind === 'yn') {
            html = match ? `<div class="result-banner win">Same answer! ${S.mine === 'yes' ? 'YES 💪' : 'NO 🙅'}</div>`
                        : `<div class="result-banner draw">Different answers! One YES, one NO 😄</div>`;
          } else if (kind === 'tf') {
            const correct = isObj ? card.a : false;
            const meRight = S.mine === correct;
            const themRight = S.theirs === correct;
            html = `<div class="result-banner ${meRight && themRight ? 'win' : meRight || themRight ? 'draw' : 'lose'}">
              The answer is <b>${correct ? 'TRUE ✅' : 'FALSE ❌'}</b>! ${esc(isObj ? card.e : '')}<br>
              ${meRight ? '✅ You got it!' : '❌ You missed it'} · ${themRight ? `✅ ${esc(api.partnerName)} got it!` : `❌ ${esc(api.partnerName)} missed it`}</div>`;
          }
          resultEl.innerHTML = html;
          nextBtn.style.display = 'inline-block';
        } else if (S.mine !== null) {
          resultEl.innerHTML = `<p class="game-prompt">Waiting for ${esc(api.partnerName)}…</p>`;
        } else {
          resultEl.innerHTML = '';
        }
        if (scoreLabel) api.setScore(scoreLabel(S));
      }

      nextBtn.onclick = () => {
        if (S.mine === null || S.theirs === null) return;
        S.q = api.draw(kind, cards.length);
        S.mine = null; S.theirs = null;
        resultEl.innerHTML = ''; nextBtn.style.display = 'none';
        render();
        api.send({ kind: 'next', q: S.q });
      };

      render();
      return {
        onMsg(d) {
          if (d.kind === 'pick' && S.theirs === null) {
            S.theirs = d.pick; S.rounds++;
            if (S.mine !== null && S.mine === S.theirs) S.synced++;
            render();
          } else if (d.kind === 'next') {
            S.q = d.q; S.mine = null; S.theirs = null;
            resultEl.innerHTML = ''; nextBtn.style.display = 'none';
            render();
          }
        },
        destroy() {}
      };
    }
  }

  Games.flag = packTwoChoice(
    'Red Flag or Green Flag', '🚩', 'Is this a red flag or a green flag? Pick secretly!',
    [['🟢 Green Flag', 'green', ''], ['🚩 Red Flag', 'red', '']],
    DATA.flag, 'flag', null,
    S => `Agree: ${S.synced}/${S.rounds}`
  );

  Games.yn = packTwoChoice(
    'Yes or No', '💭', 'Answer Yes or No — do you match?',
    [['YES 💪', 'yes', ''], ['NO 🙅', 'no', '']],
    DATA.yn, 'yn', null,
    S => `Match: ${S.synced}/${S.rounds}`
  );

  Games.tf = packTwoChoice(
    'True or False', '🧠', 'Is this statement true or false? Pick and learn!',
    [['TRUE ✅', true, ''], ['FALSE ❌', false, '']],
    DATA.tf, 'tf', null,
    S => ''
  );

  Games.rf = {
    name: 'Rapid Fire', icon: '⚡', desc: 'Quick answers — see how in sync you are!',
    init(root, api) {
      const S = { q: 0, mine: null, theirs: null };
      root.innerHTML = `<div class="game-panel">
        <div class="game-prompt">Quick! Answer in one word or sentence — then compare!</div>
        <div class="big-card-question" id="rf-q" style="min-height:70px"></div>
        <div id="rf-form"></div>
        <div id="rf-reveal"></div>
        <div style="margin-top:12px"><button class="btn btn-primary" id="rf-next" style="display:none">Next →</button></div>
      </div>`;
      const qEl = root.querySelector('#rf-q');
      const formEl = root.querySelector('#rf-form');
      const revealEl = root.querySelector('#rf-reveal');
      const nextBtn = root.querySelector('#rf-next');

      function wire() {
        formEl.querySelector('#rf-send').onclick = () => {
          const v = formEl.querySelector('#rf-in').value.trim();
          if (!v) return;
          S.mine = v;
          formEl.innerHTML = `<p class="game-prompt">Locked in ⚡ — waiting for ${esc(api.partnerName)}…</p>`;
          render();
          api.send({ kind: 'ans', ans: v });
        };
      }
      function showForm() {
        formEl.innerHTML = `
          <input type="text" id="rf-in" maxlength="100" placeholder="Your answer…" style="text-align:left">
          <button class="btn btn-primary" id="rf-send" style="margin-top:8px">Reveal time ⚡</button>`;
        wire();
      }
      function render() {
        qEl.textContent = DATA.rf[S.q % DATA.rf.length];
        if (S.mine && S.theirs) {
          revealEl.innerHTML = `
            <div style="text-align:left;max-width:440px;margin:0 auto">
              <p style="margin:8px 0"><b>${esc(api.myName)}:</b> ${esc(S.mine)}</p>
              <p style="margin:8px 0"><b>${esc(api.partnerName)}:</b> ${esc(S.theirs)}</p>
            </div>
            <div class="result-banner draw">${S.mine.toLowerCase().trim() === S.theirs.toLowerCase().trim() ? 'SAME ANSWER! 🎉 Great minds!' : 'Different answers — discuss! 😄'}</div>`;
          nextBtn.style.display = 'inline-block';
        }
      }
      nextBtn.onclick = () => {
        if (!(S.mine && S.theirs)) return;
        S.q = api.draw('rfpack', DATA.rf.length);
        S.mine = null; S.theirs = null;
        revealEl.innerHTML = ''; nextBtn.style.display = 'none';
        showForm(); render();
        api.send({ kind: 'next', q: S.q });
      };
      showForm(); render();
      return {
        onMsg(d) {
          if (d.kind === 'ans' && !S.theirs) { S.theirs = d.ans; render(); }
          else if (d.kind === 'next') {
            S.q = d.q; S.mine = null; S.theirs = null;
            revealEl.innerHTML = ''; nextBtn.style.display = 'none';
            showForm(); render();
          }
        },
        destroy() {}
      };
    }
  };

  /* ---- Mad Libs ---- */
  Games.mad = {
    name: 'Love Mad Libs', icon: '📝', desc: 'Fill in the blanks — hilarious stories!',
    init(root, api) {
      const S = { r: 0, mine: null, theirs: null, revealed: false };
      root.innerHTML = `<div class="game-panel" id="ml-panel"></div>`;
      const panel = root.querySelector('#ml-panel');

      function getTemplate() {
        const round = DATA.madRounds[S.r % DATA.madRounds.length];
        return DATA.madTemplates[round.t];
      }
      function getSlots(tpl) {
        return [...tpl.matchAll(/\{(\w+)\}/g)].map(m => m[1]);
      }

      function render() {
        const tpl = getTemplate();
        const slots = getSlots(tpl);
        if (!S.revealed && S.mine === null) {
          const inputs = slots.map((s, i) => `
            <div style="display:flex;gap:8px;align-items:center;margin:6px 0">
              <span class="card-tag" style="min-width:100px">${esc(s)}</span>
              <input type="text" class="ml-in" data-i="${i}" maxlength="40" placeholder="${esc(s)}…" style="text-align:left">
            </div>`).join('');
          panel.innerHTML = `
            <h3 class="likely-question" style="font-size:1.4rem">Love Mad Libs 📝</h3>
            <p class="game-prompt">Fill in the blanks — don't show ${esc(api.partnerName)}! 😄</p>
            ${inputs}
            <button class="btn btn-primary" id="ml-done" style="margin-top:12px">Done — reveal! 🎉</button>
            <button class="btn btn-ghost btn-small" style="color:var(--rose-dark);border-color:var(--rose-light);margin-top:8px" id="ml-back">◀ All games</button>`;
          panel.querySelector('#ml-back').onclick = () => toMode('menu');
          panel.querySelector('#ml-done').onclick = () => {
            const words = [...panel.querySelectorAll('.ml-in')].map(inp => inp.value.trim());
            if (words.some(w => !w)) { api.toast('Fill in ALL the blanks!'); return; }
            S.mine = words;
            render();
            api.send({ kind: 'fill', words });
          };
        } else if (!S.revealed && S.theirs === null) {
          panel.innerHTML = `
            <h3 class="likely-question" style="font-size:1.4rem">Love Mad Libs 📝</h3>
            <p class="game-prompt">Waiting for ${esc(api.partnerName)} to fill their blanks…</p>
            <button class="btn btn-ghost btn-small" style="color:var(--rose-dark);border-color:var(--rose-light);margin-top:8px" id="ml-back">◀ All games</button>`;
          panel.querySelector('#ml-back').onclick = () => toMode('menu');
        } else {
          // both done — reveal two stories
          const fillTpl = (words) => {
            let idx = 0;
            return tpl.replace(/\{(\w+)\}/g, () => {
              const w = words[idx] || '___';
              idx++;
              return `<b style="color:var(--rose-dark)">${esc(w)}</b>`;
            });
          };
          panel.innerHTML = `
            <h3 class="likely-question" style="font-size:1.4rem">📖 The Stories!</h3>
            <div style="text-align:left;max-width:460px;margin:10px auto">
              <p class="card-tag">${esc(api.myName)}'s version:</p>
              <p style="margin:10px 0;font-size:1.05rem;line-height:1.6">${fillTpl(S.mine)}</p>
              <p class="card-tag" style="margin-top:16px">${esc(api.partnerName)}'s version:</p>
              <p style="margin:10px 0;font-size:1.05rem;line-height:1.6">${fillTpl(S.theirs)}</p>
            </div>
            <div style="margin-top:16px">
              <button class="btn btn-primary" id="ml-next">Next story →</button>
              <button class="btn btn-ghost btn-small" style="color:var(--rose-dark);border-color:var(--rose-light)" id="ml-back">◀ All games</button>
            </div>`;
          panel.querySelector('#ml-next').onclick = () => {
            S.r = api.draw('mad', DATA.madRounds.length);
            S.mine = null; S.theirs = null; S.revealed = false;
            render();
            api.send({ kind: 'next', r: S.r });
          };
          panel.querySelector('#ml-back').onclick = () => toMode('menu');
        }
      }

      render();
      return {
        onMsg(d) {
          if (d.kind === 'fill') {
            S.theirs = d.words;
            if (S.mine) S.revealed = true;
            render();
          } else if (d.kind === 'next') {
            S.r = d.r; S.mine = null; S.theirs = null; S.revealed = false;
            render();
          }
        },
        destroy() {}
      };
    }
  };

  /* ---- Kiss, Marry, Kill ---- */
  Games.kmk = {
    name: 'Kiss, Marry, Kill', icon: '💋', desc: 'Assign all three — then reveal!',
    init(root, api) {
      const S = { q: 0, mine: null, theirs: null };
      root.innerHTML = `<div class="game-panel" id="kmk-panel"></div>`;
      const panel = root.querySelector('#kmk-panel');

      function render() {
        const trio = DATA.kmk[S.q % DATA.kmk.length];
        if (S.mine === null) {
          panel.innerHTML = `
            <h3 class="likely-question" style="font-size:1.4rem">💋 Kiss, Marry, Kill</h3>
            <p class="game-prompt">Assign each label to one choice. No repeats!</p>
            <div style="text-align:left;max-width:440px;margin:10px auto">
              ${trio.map((opt, oi) => `
                <div style="margin:10px 0;padding:10px;background:#fff0f5;border-radius:12px">
                  <p style="font-weight:700;margin:0 0 6px">${esc(opt)}</p>
                  <div style="display:flex;gap:6px;flex-wrap:wrap">
                    ${[['💋','kiss'],['💍','marry'],['💀','kill']].map(([emoji, label]) => `
                      <button class="btn btn-ghost btn-small kmk-btn" data-oi="${oi}" data-label="${label}"
                        style="color:var(--rose-dark);border-color:var(--rose-light)">${emoji} ${label}</button>`).join('')}
                  </div>
                </div>`).join('')}
            </div>
            <button class="btn btn-primary" id="kmk-done" style="display:none;margin-top:8px">Lock it in 🔒</button>
            <p class="muted" style="font-size:.8rem;margin-top:6px">Assign each label exactly once — no duplicates!</p>`;
          // handle assignment
          const assignment = {};
          panel.querySelectorAll('.kmk-btn').forEach(b => {
            b.onclick = () => {
              const oi = b.dataset.oi;
              const label = b.dataset.label;
              // remove previous assignment for this option
              if (assignment[oi]) { panel.querySelectorAll(`.kmk-btn[data-oi="${oi}"]`).forEach(x => x.classList.remove('selected', 'match')); }
              // remove this label from any other option that had it
              for (const k in assignment) { if (assignment[k] === label) { delete assignment[k]; panel.querySelectorAll(`.kmk-btn[data-oi="${k}"]`).forEach(x => x.classList.remove('selected', 'match')); } }
              assignment[oi] = label;
              b.classList.add('selected');
              // if all 3 assigned, show lock button
              if (Object.keys(assignment).length === 3) panel.querySelector('#kmk-done').style.display = 'inline-block';
              else panel.querySelector('#kmk-done').style.display = 'none';
            };
          });
          panel.querySelector('#kmk-done').onclick = () => {
            S.mine = { 0: assignment[0], 1: assignment[1], 2: assignment[2] };
            render();
            api.send({ kind: 'assign', a: S.mine });
          };
        } else if (S.theirs === null) {
          panel.innerHTML = `
            <h3 class="likely-question" style="font-size:1.4rem">💋 Kiss, Marry, Kill</h3>
            <p class="game-prompt">Locked in 🔒 — waiting for ${esc(api.partnerName)}…</p>`;
        } else {
          // reveal both
          const labelEmoji = { kiss: '💋', marry: '💍', kill: '💀' };
          const rows = trio.map((opt, oi) => {
            const myLabel = S.mine[oi];
            const theirLabel = S.theirs[oi];
            const match = myLabel === theirLabel;
            return `<div style="margin:10px 0;padding:10px;background:${match ? '#d9f2e3' : '#fff0f5'};border-radius:12px">
              <p style="font-weight:700;margin:0 0 4px">${esc(opt)}</p>
              <p style="margin:0;font-size:.95rem">${labelEmoji[myLabel]} You: <b>${myLabel}</b> · ${labelEmoji[theirLabel]} ${esc(api.partnerName)}: <b>${theirLabel}</b>${match ? ' ⭐ same!' : ''}</p>
            </div>`;
          }).join('');
          panel.innerHTML = `
            <h3 class="likely-question" style="font-size:1.4rem">💋 Reveal!</h3>
            ${rows}
            <button class="btn btn-primary" id="kmk-next" style="margin-top:12px">Next round →</button>
            <button class="btn btn-ghost btn-small" style="color:var(--rose-dark);border-color:var(--rose-light);margin-top:8px" id="kmk-back">◀ All games</button>`;
          panel.querySelector('#kmk-next').onclick = () => {
            S.q = api.draw('kmk', DATA.kmk.length);
            S.mine = null; S.theirs = null;
            render();
            api.send({ kind: 'next', q: S.q });
          };
          panel.querySelector('#kmk-back').onclick = () => toMode('menu');
        }
      }

      render();
      return {
        onMsg(d) {
          if (d.kind === 'assign') { S.theirs = d.a; if (S.mine) render(); }
          else if (d.kind === 'next') { S.q = d.q; S.mine = null; S.theirs = null; render(); }
        },
        destroy() {}
      };
    }
  };
