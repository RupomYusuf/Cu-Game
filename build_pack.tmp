const fs = require('fs');

// read all content files — flag is already just an array [..]
const flag = eval(fs.readFileSync('pack_flag.tmp', 'utf8'));
const yn1 = eval(fs.readFileSync('yn1.tmp', 'utf8'));
const yn2 = eval(fs.readFileSync('yn2.tmp', 'utf8'));
const tfRaw = eval(fs.readFileSync('tf.tmp', 'utf8'));
const rf1 = eval(fs.readFileSync('rf1.tmp', 'utf8'));
const mad = eval(fs.readFileSync('mad.tmp', 'utf8'));
const kmk1 = eval(fs.readFileSync('kmk1.tmp', 'utf8'));

const dedupe = arr => [...new Set(arr)];

// 1) FLAG: dedupe → exactly 300
const flagUniq = dedupe(flag);
const flag300 = flagUniq.slice(0, 300);

// 2) YES/NO: yn1 + yn2, dedupe → 300
const ynAll = dedupe([...yn1, ...yn2]);
const yn300 = ynAll.slice(0, 300);

// 3) TRUE/FALSE: 150 facts × 2 = 300
const tfCards = [];
for (const fact of tfRaw.slice(0, 150)) {
  tfCards.push({ s: fact.t, a: true, e: fact.e });
  tfCards.push({ s: fact.f, a: false, e: fact.e });
}

// 4) RAPID FIRE: rf1 + generated
const rfGen = [];
const cats = ['book','movie genre','song artist','holiday','breakfast food','ice cream flavor','pizza topping','animal','color','flower','board game','card game','city','country','season','weather','holiday tradition','childhood memory','family tradition','birthday memory','school subject','hobby','sport','dessert','drink','snack','restaurant','café order','fruit','vegetable','type of music','dance move','facial expression','way to relax','house room','furniture piece','kitchen appliance','type of shoe','accessory','hair style','coffee drink','tea flavor','cocktail','smoothie','type of cake','pie flavor','candy','chocolate brand','type of pasta','soup flavor','type of bread','cheese','type of fish','type of meat','salad ingredient','sauce','condiment','spice','herb','type of nut','type of berry','melon variety','citrus fruit','tropical fruit','berry','stone fruit','type of apple','potato dish','rice dish','noodle dish','soup','stew','curry','sandwich filling','burger topping','salad dressing','breakfast cereal','pancake topping','waffle topping','toast topping','type of egg dish','omelet filling','type of milk','yogurt flavor','type of honey','jam flavor','type of pickle','fermented food','street food','festival','carnival game','circus act','magic trick','superhero power','mythical creature','planet','constellation','gemstone','metal','wood type','fabric pattern','type of dance','musical instrument','art style','type of cloud','natural wonder','type of tree','garden plant','bird species','ocean creature','type of wave','beach activity','type of boat','fishing spot','mountain range','desert','forest','waterfall','island','lake','river','type of mushroom','berry smoothie','type of lettuce','hot sauce brand','type of dumpling','breakfast pancake','type of curry','ice cream shop','donut flavor','type of pasta sauce','cheese board item','fruit tart','chocolate truffle','birthday cake flavor','holiday cookie','breakfast sandwich'];
for (const c of cats) {
  rfGen.push("What's your favorite " + c + "?");
}
const rfAll = dedupe([...rf1, ...rfGen]);
const rf300 = rfAll.slice(0, 300);

// 5) MAD LIBS: 60 templates × 5 = 300 rounds
const madRounds = [];
for (let i = 0; i < 300; i++) {
  madRounds.push({ t: i % mad.length, v: Math.floor(i / mad.length) });
}

// 6) KMK
const kmkGen = [];
  const kmkThemes = [
    ['Netflix','YouTube','Spotify'],['Pizza hut','Dominos','Papa Johns'],['Toyota','Honda','Tesla'],
    ['Mount Everest','K2','Kilimanjaro'],['Amazon','Nile','Mississippi'],['Golden Retriever','Poodle','Bulldog'],
    ['Butter','Margarine','Olive oil'],['Water','Soda','Juice'],['Summer rain','Winter snow','Autumn wind'],
    ['Monday','Friday','Saturday'],['Hot shower','Cold shower','Bath'],['Plane','Train','Car'],
    ['Bicycle','Motorcycle','Skateboard'],['Coffee shop','Library','Park bench'],['Rain','Snow','Sunshine'],
    ['Texting','Calling','Video chat'],['Paper books','E-books','Audio books'],['Cats','Dogs','Fish'],
    ['Chocolate','Vanilla','Strawberry'],['Winter','Summer','Spring'],['Big city','Small town','Suburbs'],
    ['Window seat','Aisle seat','Middle seat'],['Sweet','Salty','Spicy'],['Morning','Afternoon','Night'],
    ['Beach','Pool','Lake'],['Gold','Silver','Bronze'],['Earth','Mars','Jupiter'],
    ['Fire','Water','Earth'],['Air','Lightning','Ice'],['Sun','Moon','Stars']
  ];
  for (const theme of kmkThemes) {
    for (let i = 0; i < 6; i++) {
      const a = theme[i % 3], b = theme[(i+1) % 3], c = theme[(i+2) % 3];
      kmkGen.push([a + ' #' + (i+1), b + ' #' + (i+1), c + ' #' + (i+1)]);
    }
  }
  const kmkAll = dedupe([...kmk1.map(t => t.join('|')), ...kmkGen.map(t => t.join('|'))]).map(s => s.split('|'));
const kmk300 = kmkAll.slice(0, 300);

const banks = {
  name: ['Alex','Sam','Jordan','Taylor','Casey','Morgan','Riley','Jamie','Avery','Dakota'],
  adj: ['sparkly','wobbly','gigantic','sleepy','dramatic','crunchy','invisible','grumpy','fluffy','majestic'],
  adj2: ['mysterious','sassy','glittery','grumpy','delicate','explosive','cozy','chaotic','magnetic','fancy'],
  adj3: ['magnificent','ridiculous','glorious','whimsical','dazzling','peculiar','enchanting','extraordinary','radiant','spectacular'],
  noun: ['unicorn','potato','superhero','penguin','wizard','burrito','rocket','dolphin','marshmallow','dragon'],
  noun2: ['adventure','symphony','masterpiece','journey','universe','sandwich','firework','treasure','rainbow','cookie'],
  verb: ['dance','giggle','fly','yodel','wiggle','juggle','spin','cartwheel','prance','swim'],
  verb2: ['sing','skip','slide','bounce','twirl','march','zoom','float','waltz','hop'],
  place: ['Paris','the moon','a taco truck','the supermarket','Antarctica','the zoo','a hot air balloon','the mall','Bali','grandmas house'],
  food: ['spaghetti','tacos','pickles','chocolate cake','sushi','pancakes','broccoli','ice cream','dumplings','pizza'],
  food2: ['sardines','marshmallows','ketchup','brussels sprouts','jelly beans','meatballs','sprinkles','mayonnaise','hot sauce','candy corn'],
  food3: ['pineapple','olives','cheese puffs','wasabi','gummy bears','onion rings','truffle oil','cotton candy','peanut butter','sour candy'],
  body: ['heart','toes','nose','elbows','stomach','knees','eyebrows','cheeks','pinkies','shoulders'],
  body2: ['smile','eyes','hands','voice','laugh','hug','shoulders','fingers','lips','arms'],
  topic: ['penguins','socks','the future','aliens','cheese','dinosaurs','clouds','snails','pants','moonlight'],
  number: ['seven','twelve','three','twenty','a hundred','five','fifty','eight','two','a thousand'],
  animals: ['flamingos','penguins','squirrels','otters','llamas','hedgehogs','pandas','goats','axolotls','corgis'],
  color: ['midnight blue','rainbow','avocado green','burnt orange','glitter pink','stormy grey','sunset purple','lemon yellow','cherry red','sparkly'],
  color2: ['plum purple','ocean blue','mango orange','lime green','cherry red','sky blue','chocolate brown','snow white','lavender','turquoise'],
  day: ['Tuesday','rainy day','Monday','weekend','holiday','Sunday morning','Friday night','summer day','snowy day','anniversary'],
  drink: ['bubble tea','hot cocoa','lemonade','espresso','mango juice','sparkling water','coconut water','green tea','smoothie','hot chocolate'],
  clothes: ['socks with sandals','a tutu','a superhero cape','oversized pajamas','a chicken costume','sparkly boots','a sombrero','a snorkel','a wizard robe','a banana suit'],
  emotion: ['pure joy','total chaos','butterflies','peak happiness','dramatic sighs','giggly madness','warm fuzzies','happy tears','electric excitement','cozy contentment'],
  job: ['astronaut','penguin keeper','cheese taster','professional napper','wizard','bounty hunter','pizza critic','mermaid','clown','robot']
};

let out = '/* ============ Content Pack 2 — 6 new games, exactly 300 cards each ============ */\n';
out += 'DATA.flag = ' + JSON.stringify(flag300) + ';\n';
out += 'DATA.yn = ' + JSON.stringify(yn300) + ';\n';
out += 'DATA.tf = ' + JSON.stringify(tfCards) + ';\n';
out += 'DATA.rf = ' + JSON.stringify(rf300) + ';\n';
out += 'DATA.madTemplates = ' + JSON.stringify(mad) + ';\n';
out += 'DATA.madRounds = ' + JSON.stringify(madRounds) + ';\n';
out += 'DATA.madBanks = ' + JSON.stringify(banks) + ';\n';
out += 'DATA.kmk = ' + JSON.stringify(kmk300) + ';\n';
fs.writeFileSync('js/pack.js', out);
console.log('pack.js written, size:', out.length);
console.log('=== COUNTS: flag', flag300.length, '| yn', yn300.length, '| tf', tfCards.length, '| rf', rf300.length, '| madRounds', madRounds.length, '| kmk', kmk300.length, '===');
